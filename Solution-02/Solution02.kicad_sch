	(text "Son, comme le PC : U16 (74LS74) = verrou du port 61h (O6 du 74LS138), horloge CLK_61 = OR(~WR, ~CS_61) (U9 A et B) :\nfront montant a la fin de l ecriture. Bit 0 -> GATE2 de la 8253 ; bit 1 -> validation du son. RESET -> 0 (silence).\nSPK = OUT2 ET bit 1 = NOR(~OUT2, ~SPK_EN) (U9 C, U14 D) -> R8 220 ohms -> BZ1 piezo PASSIF (sans oscillateur) -> masse.\nPort 61h en ecriture seule (lecture : bus flottant ; les programmes ne gardent que les bits 0 et 1)."
		(exclude_from_sim no)
		(at 142.24 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1931a2f2-acfb-4381-8092-eef57bfa54f2")
	)
