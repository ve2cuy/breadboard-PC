	(text "U12 = 2e 8255 (uPD71055C) sur O3 du 74LS138 : ports 30h-33h\n30h = PA, 31h = PB, 32h = PC, 33h = controle\nClavier (bit-bang, comme Solution-01) : PB0 = horloge, PB1 = donnees (entrees)\nJ4 : clavier USB a repli PS/2 (D+ = horloge, D- = donnees, comme Solution-01, tirages R2/R3 = mode PS/2)\nJ5 UART TTL : 1 = TX (PA7, sortie), 2 = RX (PB2, entree, tirage R4), 3 = GND\nAdaptateur USB-serie 5 V : son RX sur J5-1, son TX sur J5-2"
		(exclude_from_sim no)
		(at 396.24 391.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ca533026-c065-44bf-90e6-679422125cd4")
	)
