	(text "U13 = 8259A sur O2 du 74LS138 : ports 20h-21h (comme le PC)\nINT -> INTR du 8088 (broche 18, detachee de la masse), ~{INTA} <- broche 24\nMaitre unique : ~{SP}/~{EN} a +5 V, CAS0-2 libres ; IR0, IR2, IR3, IR5-IR7 libres (masquees par le BIOS)\nIR1 = clavier (INT 09h) : 74LS14 inverse KBD_CLK -> front montant au 1er front descendant de la trame\nIR4 = UART (INT 0Ch) : 74LS14 inverse UART_RX -> front montant au debut du bit de depart\nLes bits restent lus par U12 (PB0/PB1/PB2) ; portes 3 a 6 de U14 inutilisees, entrees a la masse"
		(exclude_from_sim no)
		(at 40.64 401.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7ada224a-0d7f-4e56-bdbd-051ba2062789")
	)
