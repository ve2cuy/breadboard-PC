	(text "U15 = NEC D8253C-2 (8253-2 : horloge 5 MHz max ; symbole 82C54, meme brochage) sur O4 du 74LS138 : ports 40h-43h (comme le PC)\nCLK0-2 = PCLK du 82C84 (16 MHz / 6 = 2,67 MHz) : 8253-2 ou 8254, pas une 8253 / 8253-5 (2,6 MHz max)\nGATE0-1 a +5 V ; GATE2 = bit 0 du port 61h (U16) ; OUT0 -> IR0 du 8259 (IRQ0, INT 08h) ; OUT2 -> haut-parleur ; OUT1 libre\nBIOS : compteur 0 en mode 3, diviseur 36617 -> 72,83 Hz ; 1 top du PC (18,2065 Hz) sur 4"
		(exclude_from_sim no)
		(at 40.64 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "034045e1-b252-4709-871b-2b549c133f0f")
	)
