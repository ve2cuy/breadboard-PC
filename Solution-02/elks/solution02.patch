diff --git a/elks/arch/i86/kernel/irqtab.S b/elks/arch/i86/kernel/irqtab.S
index 64c4e6e..5bb81be 100644
--- a/elks/arch/i86/kernel/irqtab.S
+++ b/elks/arch/i86/kernel/irqtab.S
@@ -195,6 +195,22 @@ save_regs:
 !       ----------PROCESS INTERRUPT----------
 */
 doirq:
+#ifdef CONFIG_HW_SOLUTION02
+//
+//      Solution-02 : the BIOS receives the UART in software (IRQ4 = start bit,
+//      bits sampled by delay loops) and must be served within half a bit
+//      (~50 us at 9600 baud). An IRQ left in service until the end of its
+//      handler (~230 us for the timer) holds IRQ1/IRQ4 back and the 8259
+//      (edge mode) loses the start bit: send the EOI now, as the BIOS does.
+//
+        cmpb    $8,%al          // IRQ 0-7 (primary 8259)
+        jae     1f
+        push    %ax
+        mov     $0x20,%al       // non-specific EOI
+        out     %al,$PIC1_CMD
+        pop     %ax
+1:
+#endif
 //
 //      Call the C code
 //
@@ -240,7 +256,12 @@ doirq:
         jmp     was_trap        // EOI already sent by bios int
 #endif
 
-do_eoi: cmp     $8,%ax          // Send EOI to interrupt controller(s)
+do_eoi:
+#ifdef CONFIG_HW_SOLUTION02
+        cmp     $8,%ax          // EOI already sent at entry (doirq)
+        jb      was_trap
+#endif
+        cmp     $8,%ax          // Send EOI to interrupt controller(s)
         mov     $0x20,%al       // EOI
         jb      a6              // IRQ on low chip
 //
